# Copy to .env for `npm run dev`. Token names are <caller>_<callee>_TOKEN; the same name is used on both sides.

# Where runners connect (Socket.IO, path /runner). Default 8080.
PORT=8080

# Backend, for verifying runner tokens.
BACKEND_URL=http://127.0.0.1:5000
# Gateway → backend. At least 32 characters; must equal the backend's GATEWAY_BACKEND_TOKEN.
GATEWAY_BACKEND_TOKEN=

# The MCP server for the agent service: /mcp/tenants/{tenantId}/clusters/{cluster}. Internal only.
# Defaults 127.0.0.1 and 8081; in the cluster MCP_HOST=0.0.0.0.
MCP_HOST=127.0.0.1
MCP_PORT=8081
# Agent service → gateway. At least 32 characters; must equal the agent service's AGENT_GATEWAY_TOKEN.
AGENT_GATEWAY_TOKEN=
