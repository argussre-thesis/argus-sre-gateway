{
  "name": "argus-sre-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Accepts runner connections and serves their ops to the agent service over MCP",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=10000 \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  }
}
